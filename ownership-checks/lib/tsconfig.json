{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2023",
		"lib": ["es2023"],
		"types": ["node"],
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "types"
	},
	"include": ["*.mjs"]
}
